# Copy this file to .env and adjust as needed. .env is gitignored and never committed.
# None of these are required for local development — safe defaults are used when unset.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database (defaults to SQLite; set DB_ENGINE=postgresql to switch)
DB_ENGINE=sqlite
DB_NAME=mathapp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Payments (defaults to a mock provider, no real credentials needed locally)
PAYMENT_PROVIDER=mock
PAYMENT_CREATE_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=

# URLs
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173
